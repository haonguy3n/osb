#!/bin/sh
set -eu

out=${1:-/boot/osb-initrd.img}
kver=${2:-$(ls -1 /lib/modules 2>/dev/null | sort | tail -1)}

MODULES="virtio_blk virtio_scsi virtio_pci virtio_mmio virtio_console
sd_mod sr_mod cdrom isofs ahci ata_piix nvme mmc_block sdhci_pci sdhci_acpi
sdhci_of_dwcmshc usb_storage uas xhci_pci xhci_plat_hcd ehci_pci ehci_platform
ohci_pci usbhid hid_generic ext4 vfat nls_cp437 nls_iso8859_1 nls_ascii loop
dm_mod dm_verity dm_crypt overlay tpm_tis tpm_crb efivarfs"

TOOLS="modprobe insmod kmod depmod cryptsetup veritysetup
tpm2 tpm2_createprimary tpm2_create tpm2_load tpm2_unseal tpm2_startauthsession
tpm2_policypcr tpm2_flushcontext sfdisk mke2fs mkfs.ext4 e2fsck resize2fs blkid"

W=$(mktemp -d /tmp/osb-initrd.XXXXXX)
trap 'rm -rf "$W"' EXIT

for d in usr/bin usr/sbin usr/lib etc proc sys dev run tmp newroot mnt; do
	mkdir -p "$W/$d"
done
for d in bin sbin lib lib64; do
	if [ -L "/$d" ]; then
		t=$(readlink "/$d")
		case "$t" in /*) mkdir -p "$W$t" ;; *) mkdir -p "$W/$t" ;; esac
		ln -s "$t" "$W/$d"
	else
		mkdir -p "$W/$d"
	fi
done

cp_file() {
	[ -e "$1" ] || return 0
	mkdir -p "$W$(dirname "$1")"
	rm -f "$W$1"
	cp -L "$1" "$W$1"
}

libs() {
	if command -v ldd >/dev/null 2>&1; then
		ldd "$1" 2>/dev/null
	else
		$(ls /lib/ld-musl-*.so.1 2>/dev/null | head -1) --list "$1" 2>/dev/null
	fi | sed -n 's/.*=> \(\/[^ ]*\).*/\1/p; s/^[[:space:]]*\(\/[^ ]*\) .*/\1/p'
}

add_file_with_libs() {
	cp_file "$1"
	for lib in $(libs "$1"); do
		cp_file "$lib"
		libr=$(readlink -f "$lib")
		[ "$libr" = "$lib" ] || cp_file "$libr"
	done
}

add_bin() {
	for b in "$@"; do
		bp=$(command -v "$b" 2>/dev/null) || continue
		case "$bp" in /*) ;; *) continue ;; esac
		br=$(readlink -f "$bp")
		add_file_with_libs "$br"
		if [ "$bp" != "$br" ]; then
			mkdir -p "$W$(dirname "$bp")"
			rm -f "$W$bp"
			ln -s "$br" "$W$bp"
		fi
	done
}

bb=$(command -v busybox)
add_bin busybox
mkdir -p "$W/bb"
for a in $("$bb" --list); do
	ln -s "$(readlink -f "$bb")" "$W/bb/$a"
done
[ -e "$W/bin/sh" ] || ln -s "$(readlink -f "$bb")" "$W/bin/sh"

add_bin $TOOLS
for l in /usr/lib/*/libtss2-tcti-device.so* /usr/lib/libtss2-tcti-device.so* /lib/libtss2-tcti-device.so*; do
	if [ -e "$l" ]; then add_file_with_libs "$l"; fi
done

if [ -n "$kver" ] && [ -d "/lib/modules/$kver" ]; then
	extra=$(find "/lib/modules/$kver/kernel/crypto" "/lib/modules/$kver/kernel/arch" -name '*.ko*' 2>/dev/null | sed 's|.*/||; s|\.ko.*||')
	for m in $MODULES $extra; do
		modprobe -S "$kver" --show-depends "$m" 2>/dev/null || true
	done | sed -n 's/^insmod \([^ ]*\).*/\1/p' | sort -u | while read -r f; do
		cp_file "$f"
	done
	for f in modules.order modules.builtin modules.builtin.modinfo; do
		cp_file "/lib/modules/$kver/$f"
	done
	depmod -b "$W" "$kver"
fi
echo "$MODULES" | tr -s ' \n' '\n\n' > "$W/etc/osb-modules"

cp /usr/lib/osb/init "$W/init"
cp /usr/bin/osb-tpm "$W/usr/bin/osb-tpm"
chmod 0755 "$W/init" "$W/usr/bin/osb-tpm"
mknod -m 600 "$W/dev/console" c 5 1 2>/dev/null || true
mknod -m 666 "$W/dev/null" c 1 3 2>/dev/null || true

find "$W" -exec touch -h -d "@${SOURCE_DATE_EPOCH:-0}" {} + 2>/dev/null || true
(cd "$W" && find . | LC_ALL=C sort | "$bb" cpio -o -H newc 2>/dev/null) | gzip -9 > "$out.tmp"
mv "$out.tmp" "$out"
echo "mkinitrd: $out ($(du -h "$out" | cut -f1), kernel $kver)"
