#!/sbin/openrc-run

description="Bring up loopback + eth0 and start a DHCP client"

depend() {
    need sysfs
    provide net
}

start() {
    ebegin "Bringing up network interfaces"
    ip link set lo up
    ip link set eth0 up

    i=0
    while [ "$i" -lt 50 ]; do
        [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" = "1" ] && break
        i=$((i + 1))
        sleep 0.1
    done

    if command -v dhcpcd >/dev/null 2>&1; then
        dhcpcd -b eth0
    else
        udhcpc -i eth0 -s /usr/share/udhcpc/default.script -b -t 5 -T 1 -A 3
    fi
    eend $?
}

stop() {
    ebegin "Stopping DHCP client"
    if command -v dhcpcd >/dev/null 2>&1; then
        dhcpcd -k eth0 2>/dev/null
    else
        killall udhcpc 2>/dev/null
    fi
    ip link set eth0 down 2>/dev/null
    ip link set lo down 2>/dev/null
    eend 0
}
